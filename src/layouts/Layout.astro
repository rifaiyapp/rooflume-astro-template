---
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/fill';
import '@fontsource/lobster-two/latin-400-italic.css';
import '@fontsource/oswald/latin-700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rooflume — Roofing & Restoration Astro Template',
  description = 'Rooflume is a roofing and restoration Astro template for fast, dependable roof repair, replacement, inspections, and storm response services.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061f49" />
    <meta name="description" content={description} />
    <meta name="author" content="KEYDIV" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="image" href="/assets/hero-roofing.png" fetchpriority="high" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
